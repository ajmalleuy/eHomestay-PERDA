APP_NAME="e-Homestay PERDA"
APP_ENV=local
APP_KEY=base64:PERDAeHomestayInapDesa2026SecretKeyExample=
APP_DEBUG=true
APP_URL=http://localhost:8080

DB_CONNECTION=mysql
DB_HOST=db
DB_PORT=3306
DB_DATABASE=perda_ehomestay
DB_USERNAME=perda_user
DB_PASSWORD=perda_secret_password

FILESYSTEM_DISK=public
MAX_PAYMENT_PROOF_KB=5120

# Guest Social Login (Laravel Socialite - keep credentials in .env, never in frontend)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI="${APP_URL}/auth/google/callback"

FACEBOOK_CLIENT_ID=
FACEBOOK_CLIENT_SECRET=
FACEBOOK_REDIRECT_URI="${APP_URL}/auth/facebook/callback"

APPLE_CLIENT_ID=
APPLE_CLIENT_SECRET=
APPLE_REDIRECT_URI="${APP_URL}/auth/apple/callback"

